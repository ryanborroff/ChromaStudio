modules = ["nodejs-24"]

[deployment]
build = ["sh", "-c", "pnpm install && pnpm --filter @workspace/chroma run build"]
publicDir = "artifacts/chroma/dist/public"
deploymentTarget = "static"
run = ""

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "nav-smoke"

[[workflows.workflow]]
name = "nav-smoke"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BASE_URL=http://localhost:20649 npx playwright test --project=chromium --reporter=line"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://web-foundation-ryanfborroff.replit.app"
VITE_DEMO_MODE = "true"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 20649
externalPort = 3000
