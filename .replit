modules = ["nodejs-24"]

[deployment]
build = ["sh", "-c", "pnpm install && pnpm --filter @workspace/chroma run build"]
publicDir = "artifacts/chroma/dist/public"
deploymentTarget = "static"
run = ""

[[deployment.rewrites]]
from = "/*"
to = "/index.html"

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PUBLIC_APP_URL = "https://web-foundation-ryanfborroff.replit.app"
VITE_DEMO_MODE = "true"
